# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored on purpose -- never commit real API keys.

API_KEY=your_api_key_here
BASE_URL=https://ai.gitee.com/v1

# Must be a model your account's resource package actually supports.
# Verified working on this project's Gitee AI account:
#   Qwen3-Coder-30B-A3B-Instruct / Hunyuan-MT-Chimera-7B / internlm3-8b-instruct
MODEL_NAME=Qwen3-Coder-30B-A3B-Instruct

# Per-request timeout in seconds
LLM_TIMEOUT=90


# --- Database: external Postgres (Supabase) ---
# Use the **Transaction pooler** connection string (port 6543). The direct
# host (port 5432) resolves to IPv6 only, which Vercel cannot reach.
# Percent-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres


# --- Attachments: Supabase Storage ---
# SUPABASE_SERVICE_KEY is the *secret* key (sb_secret_...), NOT the
# publishable one. It bypasses Row Level Security -- keep it server-side only.
SUPABASE_URL=https://tifekczhftzdjhqeuerq.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=note-attachments

# Maximum upload size in MB. Keep below Vercel's ~4.5 MB request-body limit.
MAX_UPLOAD_MB=4
